# Local development: backend tự dò từ 5000 -> 5001 -> 5002...
VITE_API_START_PORT=5000
VITE_API_PORT_SCAN_LIMIT=20
VITE_API_PROBE_TIMEOUT_MS=700

# Chỉ khai báo khi muốn ép frontend dùng một API cố định (staging/production/remote).
# VITE_API_URL=https://api.example.com/api/v1
# VITE_SERVER_URL=https://api.example.com

# Google Maps dùng cho bộ chọn vị trí khi đăng tin BĐS.
# Không commit key thật. Hãy giới hạn API key theo HTTP referrer của domain.
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_javascript_api_key
# VITE_GOOGLE_MAPS_MAP_ID=your_google_maps_map_id

# URL thương hiệu trong hệ sinh thái XSpace
VITE_KIENTRUC_URL=https://kientruchoalac.vn
VITE_MELYSPACE_URL=https://melyspace.vn

# Bật log lỗi API trong môi trường phát triển
VITE_DEBUG_API=true
