JWT_ACCESS_SECRET=change_me_access_at_least_32_characters
JWT_REFRESH_SECRET=change_me_refresh_at_least_32_characters
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
COOKIE_SECURE=false
