NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/dothihoalac

JWT_ACCESS_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_of_at_least_32_characters
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
ACCESS_COOKIE_NAME=dthl_access_token
REFRESH_COOKIE_NAME=dthl_refresh_token

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Do Thi Hoa Lac
MAIL_FROM=no-reply@dothihoalac.vn

SMS_PROVIDER=none
SMS_API_KEY=
SMS_SECRET_KEY=
SMS_BRANDNAME=

UPLOAD_PROVIDER=cloudinary
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_FOLDER=dothihoalac
UPLOAD_DIR=uploads
UPLOAD_BASE_URL=
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=100
MAX_IMAGES_PER_CONTENT=20

ADMIN_EMAIL=admin@dothihoalac.vn
ADMIN_PASSWORD=replace_with_a_strong_admin_password
SEED_USER_PASSWORD=Demo@123456

# Google Workspace / Google Docs
# Tạo OAuth Web Application trong Google Cloud, bật Google Drive API và Google Docs API.
# GOOGLE_OAUTH_REDIRECT_URI là callback gốc. Trong development, DTHL tự thay port
# localhost bằng cổng backend thực tế (5000 -> 5001 -> 5002...) sau khi server bind.
# Google vẫn yêu cầu từng URI local được đăng ký trong OAuth Client > Authorized redirect URIs.
# Ví dụ nên đăng ký các URI cần dùng:
# http://localhost:5000/api/v1/admin/google-workspace/oauth/callback
# http://localhost:5001/api/v1/admin/google-workspace/oauth/callback
# http://localhost:5002/api/v1/admin/google-workspace/oauth/callback
# Production không tự đổi host/port và phải dùng callback HTTPS cố định đã đăng ký.
GOOGLE_PROJECT_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/v1/admin/google-workspace/oauth/callback
GOOGLE_WORKSPACE_ALLOWED_DOMAIN=
# 64 ký tự hex hoặc base64 của đúng 32 byte. Không commit khóa thật lên GitHub.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# =====================================================
# NEWSROOM AI / GEMINI
# =====================================================
# API key chỉ đặt ở backend. Không đưa GEMINI_API_KEY sang Vite/frontend và không commit key thật.
# Tạo key trong Google AI Studio / Gemini Developer API rồi đặt vào server/.env.
GEMINI_API_KEY=
NEWSROOM_AI_ENABLED=false

# Model profiles. Có thể đổi model mà không sửa business logic.
GEMINI_SCOUT_MODEL=gemini-3.5-flash-lite
GEMINI_RESEARCH_MODEL=gemini-3.5-flash
GEMINI_EDITOR_MODEL=gemini-3.5-flash
GEMINI_WRITER_MODEL=gemini-3.5-flash
GEMINI_FACTCHECK_MODEL=gemini-3.5-flash

# Scout tự chạy khi NEWSROOM_AI_ENABLED=true. Manual scout vẫn đi qua DB queue.
NEWSROOM_SCOUT_INTERVAL_MINUTES=30
NEWSROOM_WORKER_INTERVAL_SECONDS=10
NEWSROOM_GEMINI_TIMEOUT_MS=90000
NEWSROOM_SCOUT_ITEMS_PER_QUERY=8
NEWSROOM_MAX_CANDIDATES_PER_RUN=40
NEWSROOM_MAX_RESEARCH_PER_RUN=8
NEWSROOM_MIN_SCOUT_SCORE=9
NEWSROOM_MIN_FACT_SCORE=9
NEWSROOM_MIN_ORIGINALITY_SCORE=9
NEWSROOM_MIN_EDITORIAL_SCORE=8
NEWSROOM_TASK_LOCK_MINUTES=15

# Tùy chọn: ghi nhiều query, phân cách bằng ||.
# Để trống sẽ dùng ma trận query Hòa Lạc mặc định trong newsroom.prompts.js.
NEWSROOM_SCOUT_QUERIES=

EXPOSE_DEV_TOKENS=true
LOG_LEVEL=debug
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=500
AUTH_RATE_LIMIT_MAX_REQUESTS=10
OTP_RATE_LIMIT_MAX_REQUESTS=5

USERNAME_CHANGE_COOLDOWN_DAYS=30
PROPERTY_DEFAULT_EXPIRE_DAYS=30
JOB_DEFAULT_EXPIRE_DAYS=30
SCHEDULER_ENABLED=true
