{
  "name": "dothihoalac-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for dothihoalac.vn",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "nodemon src/bootstrap.js",
    "start": "node src/bootstrap.js",
    "seed": "node src/seeds/index.js",
    "test": "node --test --test-reporter=spec",
    "lint": "eslint .",
    "format": "prettier --write .",
    "seed:core": "node src/seeds/index.js --core-only",
    "seed:reset": "node src/seeds/resetDatabase.js",
    "seed:properties": "node src/seeds/runPropertiesOnly.js",
    "seed:taxonomy": "node src/seeds/normalizeCategories.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.4",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.3",
    "slugify": "^1.6.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.5",
    "supertest": "^7.2.2"
  }
}
